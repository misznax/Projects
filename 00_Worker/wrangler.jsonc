{
  "name": "projects",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "d1_databases": [{ "binding": "DB", "database_name": "projects-stats", "database_id": "b7a0cc3c-4750-4b2c-aa0b-6c4cdafd1099" }],
  "send_email": [{ "name": "EMAIL" }],
  "vars": { "MAIL_FROM": "logowanie@mail.smialo.org", "MAIL_NAME": "Projects · Web Elegance", "TRIAL_DAYS": "3" },
  "placement": { "region": "aws:us-east-1" },
  "keep_vars": true,
  "observability": { "enabled": true }
}
